{
  "name": "axiomic-docs",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Documentación pública de Axiomic: cobros por transferencia en Chile para devs y agentes.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/vendor-scalar.mjs && astro dev",
