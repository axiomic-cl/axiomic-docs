    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/starlight": "0.42.6",
    "@scalar/api-reference": "1.74.0",
